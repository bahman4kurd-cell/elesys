# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# API base URL for the frontend when the app moves online.
VITE_API_BASE_URL="http://localhost:4000"

# Supabase project connection details.
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
SUPABASE_DB_HOST="db.YOUR_PROJECT_REF.supabase.co"
SUPABASE_DB_PORT="5432"
SUPABASE_DB_NAME="postgres"
SUPABASE_DB_USER="postgres"
SUPABASE_DB_PASSWORD="YOUR_DB_PASSWORD"

# Redis cache for dashboard and heavy aggregate endpoints.
REDIS_URL="redis://localhost:6379"
REDIS_TLS="false"

# Backend auth/session settings for online mode.
JWT_SECRET="CHANGE_THIS_TO_A_LONG_RANDOM_SECRET"
JWT_EXPIRES_IN="8h"
API_PORT="4000"
APP_INSTANCE_SLUG="main"

# Optional one-time admin setup used by migration and bootstrap route.
ONLINE_ADMIN_USERNAME="admin"
ONLINE_ADMIN_PASSWORD="ChangeThis123!"
BOOTSTRAP_ADMIN_KEY="CHANGE_THIS_BOOTSTRAP_KEY"
