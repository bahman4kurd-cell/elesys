    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "migrate:json": "tsx server/migration/importLocalJson.ts",
    "db:apply-schema": "tsx server/migration/applySchema.ts",
    "setup:online": "tsx server/migration/setupOnline.ts",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/leaflet": "^1.9.22",
